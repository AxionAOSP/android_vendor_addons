<?xml version="1.0" encoding="utf-8"?>
<fonts-modification version="1">

    <family name="Rookery-Regular" customizationType="new-named-family">
        <font weight="400" style="normal" postScriptName="RookeryNew-Regular">
            Rookery-Regular.otf
        </font>
        <font weight="500" style="normal" postScriptName="RookeryNew-Medium">
            Rookery-Medium.otf
        </font>
        <font weight="700" style="normal" postScriptName="RookeryNew-Bold">
            Rookery-Bold.otf
        </font>
        <font weight="400" style="italic" postScriptName="Rookery-Italic">
            Rookery-Italic.otf
        </font>
    </family>

    <!-- Nothing Fonts -->
    <family customizationType="new-named-family" name="nothingdot">
        <font weight="400" style="normal" postScriptName="Ndot-55">NDot55Caps.otf</font>
    </family>
    <family customizationType="new-named-family" name="nothingdot57">
        <font weight="400" style="normal" postScriptName="Ndot-57">NDot57Caps.otf</font>
    </family>
    <family customizationType="new-named-family" name="nothingdot57aligned">
        <font weight="400" style="normal" postScriptName="Ndot-57-Aligned">Ndot-57-Aligned.otf</font>
    </family>
    <family customizationType="new-named-family" name="NDot77JPExtended">
        <font weight="400" style="normal" postScriptName="Ndot77JPExtended">Ndot77JPExtended.otf</font>
    </family>
    <alias name="ndot" to="nothingdot" />
    <alias name="ndot57" to="nothingdot57" />
    <alias name="ndot57-align" to="nothingdot57aligned" /> 

    <!-- Fucek Font -->
    <family customizationType="new-named-family" name="fucek">
        <font weight="400" style="normal">Fucek.ttf</font>
    </family>
    <alias name="fucek-semi-bold" to="fucek" weight="600" />
    <alias name="fucek-bold" to="fucek" weight="700" />
    <alias name="times" to="fucek" />
    <alias name="times new roman" to="fucek" />
    <alias name="palatino" to="fucek" />
    <alias name="georgia" to="fucek" />
    <alias name="baskerville" to="fucek" />
    <alias name="goudy" to="fucek" />
    <alias name="fantasy" to="fucek" />
    <alias name="ITC Stone Serif" to="fucek" />

    <!-- Inter -->
    <family customizationType="new-named-family" name="inter">
        <font supportedAxes="wght,ital">Inter-Regular.ttf
          <axis tag="wdth" stylevalue="100" />
        </font>
    </family>

    <!-- Roboto -->
    <family customizationType="new-named-family" name="roboto">
        <font weight="400" style="normal">Roboto-Regular.ttf</font>
    </family>

    <!-- Roboto Flex -->
    <family customizationType="new-named-family" name="roboto-flex">
        <font supportedAxes="wght">RobotoFlex-Regular.ttf
          <axis tag="wdth" stylevalue="100" />
        </font>
    </family>

